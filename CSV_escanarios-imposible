#include <stdio.h>
#include <math.h>
#include "wolfenergy.h"  // tu firmware de referencia C

int main(void) {
    wolfenergy_t we;
    wolfenergy_init(&we);
    we.cmd_enable = 1;

    float dt = 1.0f;
    float sim_minutes = 30.0f;
    int steps = (int)(sim_minutes * 60.0f / dt);

    for (int k = 0; k < steps; ++k) {
        float t = k * dt;
        float m = t / 60.0f;

        float temps[8];
        float Ths;
        if (m <= 10.0f) {
            Ths = 25.0f + (80.0f - 25.0f) * (m / 10.0f);
            for (int i=0;i<8;i++) temps[i] = Ths;
        } else {
            Ths = 80.0f;
            temps[0] = Ths;
            for (int i=1;i<8;i++) temps[i] = Ths - 10.0f;
        }

        float I;
        if (m < 5.0f) I = 0.5f * we.c_nom_ah;
        else if (m < 10.0f) I = 1.5f * we.c_nom_ah;
        else if (m < 12.0f) I = 3.5f * we.c_nom_ah;
        else I = 0.0f;

        wolfenergy_set_measurements(&we, 51.2f, I, temps, 8);
        wolfenergy_update(&we, dt);

        printf("%f,%d,%d\n", t, we.state, we.fault);
    }
    return 0;
}

